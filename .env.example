# Copy to .env.local for local dev. NEVER commit real values.

# Postgres connection string. Leave empty in local dev to use the embedded
# PGlite database stored in ./.data/pglite.
DATABASE_URL=

# The owner's email. Only this address can create the account (at /daftar).
# After that, the login email is changed in Pengaturan → Akun.
APP_USER_EMAIL=you@example.com

# Random secret for signing session cookies (min 32 chars).
# Generate with: npm run gen-secret
SESSION_SECRET=

# Email for account links (setup, forgotten password, new email) and security
# notices, sent with Resend (https://resend.com). Leave empty in local dev:
# emails are printed in the terminal instead.
RESEND_API_KEY=
# Without your own domain in Resend, keep the default sender; it can only send
# to the email address of your Resend account.
EMAIL_FROM=Jatahin! <onboarding@resend.dev>

# Public URL used in email links. On Vercel the production domain is used
# automatically; set this when using a custom domain.
APP_URL=
